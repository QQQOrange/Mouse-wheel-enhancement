<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ══════════════════════════════════════════════════════════════════
    启动器（Launcher）—— 唯一对外交付的 exe
    ══════════════════════════════════════════════════════════════════

    # 为什么要有这个项目

    主程序是**框架依赖**发布（0.43 MB，不带运行时）。当机器上没有 .NET 10 时，
    .NET 的 apphost 会在加载我们的代码**之前**就失败 —— 也就是说主程序里写的任何
    "检测 + 提示"都不可能被执行到。要在这个场景下弹自己的窗口，就必须有一个
    **不依赖 .NET 10** 的程序先跑起来。

    # 为什么用 .NET Framework 4.8

    Windows 10 1809 及以上**内置** .NET Framework 4.8，所以这个启动器不需要用户装任何东西。
    相比 NativeAOT（要 C++ 工具链）和原生 C++（要完整 Windows SDK），这是唯一
    "零额外依赖、零工具链"的方案。

    # 主程序是**内嵌**在这个 exe 里的

    发布时把 MouseWheelEnhancement.App.exe 作为嵌入资源打进来（见 AppPayload 属性）。
    运行时释放到 %LOCALAPPDATA%\MouseWheelEnhancement\app\<版本>\ 再启动。

    这样做是为了让用户**只看到一个 exe**：两个 exe 并排放在文件夹里，
    任何人都会以为装了两份软件、然后纠结"哪个是真的、另一个能不能删"。

    # 它绝不能成为新的故障点

    · 运行时检测到就启动、检测不到才弹窗；
    · **任何检测异常都按"放行"处理**（fail-open）：宁可让主程序自己去撞 apphost 的提示，
      也不能因为本程序判断失误把能正常用的软件拦在门外；
    · 释放失败时给出明确的一句话，而不是静默退出。
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>MouseWheelEnhancement</AssemblyName>
    <RootNamespace>MouseWheelEnhancement.Launcher</RootNamespace>
    <ApplicationIcon>..\app.ico</ApplicationIcon>
    <Product>鼠标滚轮增强</Product>
    <AssemblyTitle>鼠标滚轮增强</AssemblyTitle>
    <Company>QQQOrange</Company>
    <Description>鼠标滚轮增强 —— 一个 exe 里带着主程序与 .NET 检测</Description>
    <!-- 版本与主程序保持一致；publish.ps1 会显式传入 -->
    <Version Condition="'$(Version)' == ''">1.3.0</Version>
    <Deterministic>true</Deterministic>
    <!-- net48 上不需要，也不该带 pdb 进安装目录 -->
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!--
    内嵌主程序。路径由 publish.ps1 通过 -p:AppPayload=... 传入 ——
    它必须指向**已经发布好的单文件主程序**，所以构建顺序是「先发布主程序，再编译启动器」。

    单独 dotnet build 这个项目时没有这个属性，资源为空；启动器会明确提示
    "安装不完整"，而不是莫名退出。
  -->
  <ItemGroup Condition="'$(AppPayload)' != '' and Exists('$(AppPayload)')">
    <EmbeddedResource Include="$(AppPayload)">
      <LogicalName>MouseWheelEnhancement.App.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
