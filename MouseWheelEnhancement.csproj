<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 启动器占用 MouseWheelEnhancement.exe，主程序是 .App.exe -->
    <AssemblyName>MouseWheelEnhancement.App</AssemblyName>
    <RootNamespace>MouseWheelEnhancement</RootNamespace>
    <Version>1.5.6</Version>
    <FileVersion>1.5.6.0</FileVersion>
    <Product>鼠标滚轮增强</Product>
    <AssemblyTitle>鼠标滚轮增强</AssemblyTitle>
    <Company>QQQOrange</Company>
    <Description>保持普通滚动体验不变，只增强快速滚动的鼠标滚轮工具</Description>
    <Copyright>© 2026 QQQOrange</Copyright>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- 中文界面，不生成语言资源卫星包 -->
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- WinForms 会抱怨清单里写了 DPI；WPF 必须写在清单里，这里忽略该建议 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <!--
    ══════════════ 发布形态 ══════════════

    默认 **框架依赖 + 单文件**：exe 里只有本程序的代码和资源，运行时由系统里
    已装的 .NET 10 桌面运行时提供 —— 产物不到 0.5 MB。

    以前默认是自包含（把整个 .NET 运行时打进 exe），体积 66 MB。经测量那 66 MB
    里本程序只占 0.21 MB（0.1%），其余全是运行时和 WPF/WinForms 程序集。
    本程序是常驻托盘的小工具，为了一个 200 KB 的 exe 背 66 MB 运行时不划算，
    所以改成默认框架依赖；需要"拷到没装 .NET 的机器也能跑"时用：
        tools\publish.ps1 -SelfContained
  -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- 自包含才有"压缩"和"提取原生库"这两件事；框架依赖时设了会直接报 NETSDK1176 -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true' and '$(SelfContained)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- 自包含时剔掉两个只在该场景下才会被拖进来的纯设计期/诊断用程序集（约 8 MB） -->
  <Target Name="DropDesignTimeAssemblies" AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)%(Extension)' == 'System.Windows.Forms.Design.dll'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)%(Extension)' == 'Microsoft.DiaSymReader.Native.amd64.dll'" />
    </ItemGroup>
  </Target>


  <!--
    启动器是**另一个目标框架**（net48）的独立项目，放在 Launcher/ 子目录里。
    但 SDK 默认会把子目录下的 *.cs 一并编译进本项目 —— 结果是启动器的 Program.cs
    和本项目的生成 AssemblyInfo 撞在一起（CS0579 特性重复）。这里明确排除掉。
  -->
  <ItemGroup>
    <Compile Remove="Launcher/**" />
    <None Remove="Launcher/**" />
    <Page Remove="Launcher/**" />
  </ItemGroup>

  <!--
    WPF + WinForms 双栈项目里，WindowsDesktop SDK 默认会把 System.Drawing 和
    System.Windows.Forms 塞进隐式 using，于是 Brush / MessageBox / Application
    在 WPF 文件里全部变成"引用不明确"，而 System.IO 反而不在里面。
    这里把这两个全局 using 拿掉（TrayController 自己显式 using），
    再把真正到处要用的命名空间补回来。
  -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <Using Include="System.Collections.ObjectModel" />
  </ItemGroup>

</Project>
