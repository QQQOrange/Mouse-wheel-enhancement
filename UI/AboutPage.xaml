<UserControl x:Class="MouseWheelEnhancement.UI.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,18,24,26">

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Width="52" Height="52" CornerRadius="14"
                                            Background="{DynamicResource AccentSoft}" Margin="0,0,16,0">
                                        <TextBlock Text="⟳" FontSize="26" Foreground="{DynamicResource AccentHover}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="鼠标滚轮增强" Style="{StaticResource H1}" />
                                        <TextBlock Text="Mouse wheel enhancement" Style="{StaticResource Caption}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="当前版本" Style="{StaticResource Caption}" />
                                    <TextBlock x:Name="AboutVersion" Grid.Column="1" Style="{StaticResource Mono}"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="界面语言" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Caption}"
                                               Text="主界面与帮助页；切换后立即生效" Margin="0,0,10,0" />
                                    <Border Grid.Column="2" Style="{StaticResource SegGroup}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="LangZh" GroupName="lang" Content="简体中文"
                                                         AutomationProperties.Name="帮助页语言：简体中文"
                                                         Style="{StaticResource SegRadio}" Checked="Language_Changed" />
                                            <RadioButton x:Name="LangEn" GroupName="lang" Content="English"
                                                         AutomationProperties.Name="帮助页语言：English"
                                                         Style="{StaticResource SegRadio}" Checked="Language_Changed" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="开发者" Style="{StaticResource Caption}" />
                                    <TextBlock x:Name="AboutAuthor" Grid.Column="1" Style="{StaticResource Mono}"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="项目主页" Style="{StaticResource Caption}" />
                                    <Button x:Name="HomeBtn" Grid.Column="1" Style="{StaticResource LinkButton}"
                                            HorizontalAlignment="Left" Click="OpenHome_Click">
                                        <TextBlock x:Name="HomeText" Style="{StaticResource Mono}" FontSize="12"
                                                   Foreground="{DynamicResource AccentHover}" />
                                    </Button>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="GitHub" Style="{StaticResource Caption}" />
                                    <Button x:Name="GitHubBtn" Grid.Column="1" Style="{StaticResource LinkButton}"
                                            HorizontalAlignment="Left" Click="OpenGitHub_Click"
                                            ToolTip="git clone git@github.com:QQQOrange/Mouse-wheel-enhancement.git">
                                        <TextBlock x:Name="GitHubText" Style="{StaticResource Mono}" FontSize="12"
                                                   Foreground="{DynamicResource AccentHover}" />
                                    </Button>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="发布页面" Style="{StaticResource Caption}" />
                                    <Button x:Name="ReleasesBtn" Grid.Column="1" Style="{StaticResource LinkButton}"
                                            HorizontalAlignment="Left" Click="OpenReleases_Click">
                                        <TextBlock x:Name="ReleasesText" Style="{StaticResource Mono}" FontSize="12"
                                                   Foreground="{DynamicResource AccentHover}" />
                                    </Button>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="许可证" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Mono}"
                                               Foreground="{DynamicResource TextPrimary}" Text="MIT License" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="文件与诊断" Style="{StaticResource H2}" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="数据目录" Style="{StaticResource Caption}" />
                                    <TextBlock x:Name="AboutDataDir" Grid.Column="1" Style="{StaticResource Mono}"
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <Button Grid.Column="2" Content="打开" Style="{StaticResource GhostButton}"
                                            Click="OpenDataDir_Click" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="日志" Style="{StaticResource Caption}" />
                                    <TextBlock x:Name="AboutLogPath" Grid.Column="1" Style="{StaticResource Mono}"
                                               FontSize="11" TextWrapping="Wrap" />
                                    <Button Grid.Column="2" Content="打开" Style="{StaticResource GhostButton}"
                                            Click="OpenLog_Click" />
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="运行权限" Style="{StaticResource Caption}" />
                                    <TextBlock x:Name="AboutElevation" Grid.Column="1" Style="{StaticResource Mono}"
                                               FontSize="11.5" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button Content="导出诊断包…" Style="{StaticResource GhostButton}"
                                            Click="ExportDiag_Click" Margin="0,0,8,0"
                                            ToolTip="把配置、日志和环境信息打成一个 zip；反馈问题时发这个最省事" />
                                    <Button Content="导出配置…" Style="{StaticResource GhostButton}"
                                            Click="ExportConfig_Click" Margin="0,0,8,0"
                                            ToolTip="只导出 config.json，可带到另一台机器导入" />
                                    <Button Content="导出帮助文案…" Style="{StaticResource GhostButton}"
                                            Click="ExportHelp_Click" Margin="0,0,8,0"
                                            AutomationProperties.Name="导出帮助文案"
                                            ToolTip="把帮助页文案导出为 JSON；翻译时直接改字符串，结构别动" />
                                    <Button Content="导入配置…" Style="{StaticResource GhostButton}"
                                            Click="ImportConfig_Click"
                                            ToolTip="从一份 config.json 恢复设置（会整体覆盖当前设置）" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="RestartHookBtn" Content="重启钩子" Style="{StaticResource GhostButton}"
                                            Click="RestartHook_Click" />
                                    <Button Content="打开配置文件夹" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                            Click="OpenDataDir_Click" />
                                    <Button Content="恢复默认设置" Style="{StaticResource DangerButton}" Margin="10,0,0,0"
                                            Click="ResetDefaults_Click" />
                                    <Button Content="退出程序" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                            Click="ExitApp_Click"
                                            ToolTip="完全退出（托盘图标也会消失）。平时点 × 只是收回托盘" />
                                </StackPanel>

                                <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,18,0,14" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="实时输入监视" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}"
                                                   Text="打开后显示最近一次滚轮事件的判定（目标、原始 delta、倍率、输出）。只读，不写日志；平时请保持关闭，避免热路径拼字符串。" />
                                    </StackPanel>
                                    <ToggleButton x:Name="InputMonitorSwitch" Grid.Column="1"
                                                  Style="{StaticResource Switch}" VerticalAlignment="Center"
                                                  AutomationProperties.Name="实时输入监视"
                                                  Checked="InputMonitor_Toggled"
                                                  Unchecked="InputMonitor_Toggled" />
                                </Grid>
                                <Border Background="{DynamicResource CardBg2}" CornerRadius="8"
                                        Margin="0,10,0,0" Padding="12,9" MinHeight="34">
                                    <TextBlock x:Name="InputMonitorText" Style="{StaticResource Mono}"
                                               FontSize="11.5" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Text="已关闭。打开开关后在这里滚动一下。" />
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
</UserControl>
