<UserControl x:Class="MouseWheelEnhancement.UI.SmoothPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,18,24,26">

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="手感曲线" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,10"
                               Text="不想逐个调滑块就选一个现成的：下面几档只改「跟手时间」和「惯性长度」，其余参数不动。" />
                    <WrapPanel x:Name="PresetPanel">
                        <Button Content="干脆" Style="{StaticResource GhostButton}" Tag="crisp"
                                Click="CurvePreset_Click" Margin="0,0,8,0"
                                ToolTip="收尾快、惯性短（τ 30ms / 惯性 100ms）" />
                        <Button Content="顺滑" Style="{StaticResource GhostButton}" Tag="smooth"
                                Click="CurvePreset_Click" Margin="0,0,8,0"
                                ToolTip="默认手感（τ 40ms / 惯性 320ms）" />
                        <Button Content="触控板 · 推荐" Style="{StaticResource GhostButton}" Tag="trackpad"
                                Click="CurvePreset_Click" Margin="0,0,8,0"
                                ToolTip="按真实触控板实测重定（τ 45ms / 惯性 300ms）：单格约 100ms 连续推进，慢滚不飘" />
                        <Button Content="触控板级" Style="{StaticResource GhostButton}" Tag="trackpad-plus"
                                Click="CurvePreset_Click" Margin="0,0,8,0"
                                ToolTip="触控板曲线 + 细腻模式（每档 60px → 20px），WPF/Qt 里也能逐行推进" />
                        <Button Content="悠长" Style="{StaticResource GhostButton}" Tag="long"
                                Click="CurvePreset_Click"
                                ToolTip="收得更慢、滑得更远（τ 60ms / 惯性 450ms）" />
                    </WrapPanel>
                    <TextBlock x:Name="CurveSummary" Style="{StaticResource Caption}"
                               Margin="0,10,0,0" Text="当前：跟手 40 ms · 惯性 320 ms" />
                    <Border Background="{DynamicResource CardBg2}" CornerRadius="8"
                            Height="86" Margin="0,12,0,0" ClipToBounds="True">
                        <Canvas x:Name="SmoothPreview" ClipToBounds="True"
                                AutomationProperties.Name="跟手曲线预览"
                                SizeChanged="SmoothPreview_SizeChanged" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="动画模型" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,10"
                               Text="决定「一格的距离怎样摊到各帧」。指数衰减是默认手感：能自然叠加连滚、渐近收尾，参数按触控板实测标定。逐格缓动参考 SmoothScroll——每一格在固定时长内按选定曲线走完，落点时间确定，尾巴形状可以直接选。" />
                    <Border Style="{StaticResource SegGroup}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ModelDecay" GroupName="model" Content="指数衰减"
                                         Style="{StaticResource SegRadio}" Checked="Model_Changed"
                                         ToolTip="每一帧发「剩余量的一小部分」，可叠加、没有硬停（推荐）" />
                            <RadioButton x:Name="ModelEased" GroupName="model" Content="逐格缓动"
                                         Style="{StaticResource SegRadio}" Checked="Model_Changed"
                                         ToolTip="每一格在固定时长内走完，曲线可选；落点时间确定" />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="EasedPanel" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="缓动曲线" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Text="脉冲：两边都慢、中间匀，起手不窜、落点不砸（SmoothScroll 的原版曲线，推荐）。五次：起手最快、尾巴最长。三次：中段更匀。指数：起手最快、尾巴最短。线性：匀速，最机械。" />
                            </StackPanel>
                            <ComboBox x:Name="EasingBox" Grid.Column="1" Width="132" Margin="12,0,0,0"
                                      VerticalAlignment="Center" SelectionChanged="Easing_Changed"
                                      AutomationProperties.Name="缓动曲线">
                                <ComboBoxItem Content="脉冲（推荐）" Tag="pulse" />
                                <ComboBoxItem Content="五次" Tag="quintic" />
                                <ComboBoxItem Content="三次" Tag="cubic" />
                                <ComboBoxItem Content="指数" Tag="exponential" />
                                <ComboBoxItem Content="线性" Tag="linear" />
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="单格动画时长" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="EasedMsValue" Grid.Column="1" Style="{StaticResource Value}"
                                       Text="220 ms" />
                        </Grid>
                        <Slider x:Name="EasedMsSlider" Style="{StaticResource HSlider}" Margin="0,10,0,0"
                                Minimum="80" Maximum="600" SmallChange="10" LargeChange="40"
                                TickFrequency="10" IsSnapToTickEnabled="True"
                                AutomationProperties.Name="单格动画时长"
                                ValueChanged="EasedMs_Changed" />
                        <TextBlock x:Name="EasedHint" Style="{StaticResource Caption}" Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Text="一格从开始到落点走多久。越短越跟手，越长越绵。脉冲曲线推荐 280 ms（单格实测 280 ms、单帧最多 5 单位）；220 ms 适合逐格缓动，SmoothScroll 原版默认 360 ms，实测偏飘。" />

                        <StackPanel x:Name="PulsePanel" Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="脉冲强度" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                               Text="只对「脉冲」曲线有效：越大起步越急（缓起段更短、峰值速度更高），越小越绵。4 = 用前 25% 的时间缓起，与 SmoothScroll 一致。" />
                                </StackPanel>
                                <TextBlock x:Name="PulseValue" Grid.Column="1" Style="{StaticResource Value}"
                                           Text="4.0" VerticalAlignment="Top" Margin="12,0,0,0" />
                            </Grid>
                            <Slider x:Name="PulseSlider" Style="{StaticResource HSlider}" Margin="0,10,0,0"
                                    Minimum="2" Maximum="8" SmallChange="0.5" LargeChange="1"
                                    TickFrequency="0.5" IsSnapToTickEnabled="True"
                                    AutomationProperties.Name="脉冲强度"
                                    ValueChanged="Pulse_Changed" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="平滑滚动" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="把一次滚动摊成多帧小步发出去，接近触控板那种连续顺滑的推进感。" />
                        </StackPanel>
                        <ToggleButton x:Name="SmoothSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                      VerticalAlignment="Center" Checked="Smooth_Changed"
                                      Unchecked="Smooth_Changed" />
                    </Grid>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="每格滚动格数" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="一个滚轮刻度滚几行。这一项直接写进系统设置，和系统面板是同一个值：这里调多少，系统鼠标设置里就变成多少；在系统里改，这里也会跟着变。普通情况下软件启动、退出都不会去动它——只有打开下面的「细腻模式」时，运行期间才会临时改成 1 行，退出/崩溃时还原。" />
                        </StackPanel>
                        <TextBlock x:Name="WheelLinesValue" Grid.Column="1" Style="{StaticResource Value}"
                                   Text="3 行" />
                    </Grid>
                    <Slider x:Name="WheelLinesSlider" Style="{StaticResource HSlider}" Margin="0,10,0,0"
                            Minimum="1" Maximum="10" SmallChange="1" LargeChange="1"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            AutomationProperties.Name="每格滚动格数"
                            ValueChanged="WheelLines_Changed" />
                    <TextBlock x:Name="WheelLinesHint" Style="{StaticResource Caption}"
                               Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="指针速度、左右键这些在系统面板里，这里只做跳转。" />
                        </StackPanel>
                        <Button x:Name="OpenMouseSettingsBtn" Grid.Column="1"
                                Style="{StaticResource GhostButton}" Content="打开系统鼠标设置"
                                Click="OpenMouseSettings_Click" />
                    </Grid>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="施加范围" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="「所有滚动」是默认：慢慢拨一格也会被拆成几帧滑上去；「仅加速时」则只处理快滚，普通滚动完全交给系统。" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                       Text="注意：WPF / WinForms / Qt 写的程序滚动时只看方向、不看增量，一个消息就滚固定一档。对它们会自动改用「整格」方式：第一档立刻发，之后每帧最多一档，所以不会一滚一整页；但框架的最小粒度就是一格，做不到浏览器那种亚像素推进。" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource SegGroup}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ScopeBoosted" GroupName="scope" Content="仅加速时"
                                             Style="{StaticResource SegRadio}" Checked="Scope_Changed" />
                                <RadioButton x:Name="ScopeAlways" GroupName="scope" Content="所有滚动"
                                             Style="{StaticResource SegRadio}" Checked="Scope_Changed" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="注入帧率" FontWeight="SemiBold" />
                            <TextBlock x:Name="FpsHint" Style="{StaticResource Caption}"
                                       Text="自动跟着显示器刷新率走：屏幕多少 Hz，就每多少毫秒推一小步。"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock x:Name="FpsValue" Grid.Column="1" Style="{StaticResource Value}"
                                   Text="自动 · —" Margin="12,0,0,0" VerticalAlignment="Top" />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton x:Name="AutoFpsSwitch" Style="{StaticResource Switch}"
                                          VerticalAlignment="Center"
                                          Checked="AutoFps_Changed" Unchecked="AutoFps_Changed" />
                            <TextBlock Text="自动跟随显示器刷新率" Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Border x:Name="FpsManualGroup" Grid.Column="1"
                                Style="{StaticResource SegGroup}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="Fps60" GroupName="fps" Content="60"
                                             Style="{StaticResource SegRadio}" Checked="Fps_Changed" />
                                <RadioButton x:Name="Fps90" GroupName="fps" Content="90"
                                             Style="{StaticResource SegRadio}" Checked="Fps_Changed" />
                                <RadioButton x:Name="Fps120" GroupName="fps" Content="120"
                                             Style="{StaticResource SegRadio}" Checked="Fps_Changed" />
                                <RadioButton x:Name="Fps144" GroupName="fps" Content="144"
                                             Style="{StaticResource SegRadio}" Checked="Fps_Changed" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="帧同步" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Text="每帧先等一次显示器的合成帧再发出去，让每一小步都落在自己那一帧里——同样帧率下观感更整齐。只在「自动跟随显示器刷新率」时生效；全屏独占程序、远程桌面里 DWM 跟不上时会自动退回普通定时器。" />
                        </StackPanel>
                        <ToggleButton x:Name="VsyncSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                      VerticalAlignment="Center"
                                      Checked="Vsync_Changed" Unchecked="Vsync_Changed"
                                      AutomationProperties.Name="帧同步" />
                    </Grid>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="每格拆分" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="一格（120 单位）拆成几帧发。4 表示每帧 30 单位——正好整除，老程序也不会丢量。数值越大越细腻。" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource SegGroup}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="Fpn2" GroupName="fpn" Content="2"
                                             Style="{StaticResource SegRadio}" Checked="Fpn_Changed" />
                                <RadioButton x:Name="Fpn3" GroupName="fpn" Content="3"
                                             Style="{StaticResource SegRadio}" Checked="Fpn_Changed" />
                                <RadioButton x:Name="Fpn4" GroupName="fpn" Content="4"
                                             Style="{StaticResource SegRadio}" Checked="Fpn_Changed" />
                                <RadioButton x:Name="Fpn6" GroupName="fpn" Content="6"
                                             Style="{StaticResource SegRadio}" Checked="Fpn_Changed" />
                                <RadioButton x:Name="Fpn8" GroupName="fpn" Content="8"
                                             Style="{StaticResource SegRadio}" Checked="Fpn_Changed" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="跟手时间（τ）" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="越小越跟手、越大越绵。按实测触控板节奏，40~60ms 最像：一个普通滚轮格约 100ms 连续推进。" />
                        </StackPanel>
                        <TextBlock x:Name="TauValue" Grid.Column="1" Style="{StaticResource Value}"
                                   Text="45 ms" />
                    </Grid>
                    <Slider x:Name="TauSlider" Style="{StaticResource HSlider}" Margin="0,10,0,0"
                            Minimum="30" Maximum="120" SmallChange="5" LargeChange="5"
                            TickFrequency="5" IsSnapToTickEnabled="True"
                            AutomationProperties.Name="跟手时间（τ）"
                            ValueChanged="Tau_Changed" />
                    <Grid Margin="0,3,9,0">
                        <TextBlock Text="30 ms · 紧跟" Style="{StaticResource Caption}" FontSize="10.5"
                                   HorizontalAlignment="Left" />
                        <TextBlock Text="120 ms · 很绵" Style="{StaticResource Caption}" FontSize="10.5"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="松手后的惯性" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Text="只有「甩」才给惯性：慢滚一格不会飘，快甩才顺着原方向滑这么久。0 = 不额外滑行。" />
                        </StackPanel>
                        <TextBlock x:Name="GlideValue" Grid.Column="1" Style="{StaticResource Value}"
                                   Text="300 ms" />
                    </Grid>
                    <Slider x:Name="GlideSlider" Style="{StaticResource HSlider}" Margin="0,10,0,0"
                            Minimum="0" Maximum="600" SmallChange="10" LargeChange="20"
                            TickFrequency="10" IsSnapToTickEnabled="True"
                            AutomationProperties.Name="松手后的惯性"
                            ValueChanged="Glide_Changed" />
                    <Grid Margin="0,3,9,0">
                        <TextBlock Text="0 · 关闭滑行" Style="{StaticResource Caption}" FontSize="10.5"
                                   HorizontalAlignment="Left" />
                        <TextBlock Text="600 ms · 飘得较远" Style="{StaticResource Caption}" FontSize="10.5"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <!-- 两项参数打架时给一句人话：光开滑行没用，跟手期得有量留下 -->
                    <TextBlock x:Name="GlideHint" Style="{StaticResource Caption}" Margin="0,8,0,0"
                               TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{DynamicResource WarnBrush}" />
                </StackPanel>
            </Border>

            <Button x:Name="AdvancedBacklogToggle" Content="高级参数：积压上限"
                    Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                    Margin="2,0,0,2" Click="AdvancedBacklog_Click" />

            <StackPanel x:Name="AdvancedBacklogPanel" Visibility="Collapsed">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="积压上限" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Text="连续甩动时最多攒下多少格还没发。超过的部分会被丢掉，而不是「一次性全倒出去」——后者正是快速连甩收尾时那一下大跳的来源。" />
                        </StackPanel>
                        <TextBlock x:Name="BacklogValue" Grid.Column="1" Style="{StaticResource Value}"
                                   Text="5 格" />
                    </Grid>
                    <Slider x:Name="BacklogSlider" Style="{StaticResource HSlider}" Margin="0,10,0,0"
                            Minimum="1" Maximum="20" SmallChange="1" LargeChange="2"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            AutomationProperties.Name="积压上限"
                            ValueChanged="Backlog_Changed" />
                    <Grid Margin="0,3,9,0">
                        <TextBlock Text="1 格 · 最跟手" Style="{StaticResource Caption}" FontSize="10.5"
                                   HorizontalAlignment="Left" />
                        <TextBlock Text="20 格 · 最能攒" Style="{StaticResource Caption}" FontSize="10.5"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
