<UserControl x:Class="MouseWheelEnhancement.UI.AppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,18,24,26">

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="名单模式" Style="{StaticResource H2}" Margin="0,0,0,4" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,14"
                                           Text="先决定名单是「排除」用的还是「只允许」用的，再往里面加程序。改动即时生效，不用重启。" />
                                <Border Style="{StaticResource SegGroup}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ModeBlack" GroupName="mode" Content="黑名单（名单里的不增强）"
                                                     Style="{StaticResource SegRadio}" Checked="Mode_Changed" />
                                        <RadioButton x:Name="ModeWhite" GroupName="mode" Content="白名单（只增强名单里的）"
                                                     Style="{StaticResource SegRadio}" Checked="Mode_Changed" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="添加应用" Style="{StaticResource H2}" Margin="0,0,0,4" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12"
                                           Text="按进程名（exe 文件名）匹配，不区分大小写。可以直接粘贴完整路径，会自动只留文件名。" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="AddAppBox" Style="{StaticResource DarkTextBox}"
                                             ToolTip="例如 chrome.exe" />
                                    <Button Grid.Column="1" x:Name="PickRunningBtn" Content="从运行中的应用选择"
                                            Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Click="PickRunning_Click" />
                                    <Button Grid.Column="2" Content="添加" Style="{StaticResource PrimaryButton}"
                                            Margin="8,0,0,0" Click="AddApp_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="当前名单" Style="{StaticResource H2}" />
                                    <TextBlock x:Name="AppsCount" Grid.Column="1" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" Text="0 项" />
                                </Grid>
                                <TextBox x:Name="AppsFilterBox" Style="{StaticResource DarkTextBox}"
                                         Margin="0,0,0,10" TextChanged="AppsFilter_Changed"
                                         AutomationProperties.Name="筛选应用名单"
                                         ToolTip="按 exe 名或备注筛选（不影响名单本身）" />
                                <ListBox x:Name="AppsList" Style="{StaticResource PlainListBox}"
                                         ItemContainerStyle="{StaticResource PlainListBoxItem}" MaxHeight="330"
                                         MouseRightButtonUp="AppsList_RightClick"
                                         ToolTip="右键某个程序，可单独设它的倍率上限和平滑开关">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="20" Height="20" CornerRadius="5"
                                                        Background="{DynamicResource CardBg2}"
                                                        VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <Grid>
                                                        <Ellipse Width="7" Height="7" Opacity="0.5"
                                                                 Fill="{DynamicResource BorderBrushStrong}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image Source="{Binding Icon}" Width="18" Height="18"
                                                               Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Exe}" Style="{StaticResource Mono}"
                                                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" />
                                                        <TextBlock Text="{Binding Override}" Style="{StaticResource Caption}"
                                                                   Margin="6,0,0,0"
                                                                   Foreground="{DynamicResource AccentHover}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="✕" Style="{StaticResource TinyButton}"
                                                        Tag="{Binding Exe}" Click="RemoveApp_Click"
                                                        ToolTip="从名单移除" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="AppsNoMatch" Style="{StaticResource Caption}"
                                           Margin="2,8,0,0" Visibility="Collapsed"
                                           Text="没有匹配的程序。清空上面的筛选框即可看到全部。" />
                                <Border x:Name="AppsEmpty" Visibility="Collapsed" Margin="0,6,0,0"
                                        Background="{DynamicResource CardBg2}" CornerRadius="10" Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="名单是空的" FontWeight="SemiBold" FontSize="12.5" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                                   Text="点上面的「从运行中的应用选择」，或右键托盘图标一键把当前程序加进来。" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="按窗口标题匹配（可选）" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,10"
                                           Text="一个正则表达式，不区分大小写。命中同样按名单模式处理。留空即关闭。例如 remote|远程 可以把所有远程桌面窗口排除掉。" />
                                <TextBox x:Name="TitleRegexBox" Style="{StaticResource DarkTextBox}"
                                         TextChanged="TitleRegex_Changed" />
                                <TextBlock x:Name="RegexHint" Style="{StaticResource Caption}" Margin="0,8,0,0"
                                           Visibility="Collapsed" Foreground="{DynamicResource DangerBrush}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
</UserControl>
