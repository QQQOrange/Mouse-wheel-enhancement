<Window x:Class="MouseWheelEnhancement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="鼠标滚轮增强" Height="780" Width="940" MinHeight="620" MinWidth="880"
        Background="{StaticResource WindowBg}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══════════════ 顶部：标题 + 状态 + 总开关 ══════════════ -->
        <Border Grid.Row="0" Padding="22,18,22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentSoft}"
                            Margin="0,0,13,0">
                        <TextBlock Text="⟳" FontSize="19" Foreground="{StaticResource AccentHover}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="鼠标滚轮增强" Style="{StaticResource H1}" />
                        <TextBlock x:Name="SubtitleText" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                   Text="Mouse wheel enhancement" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="StatusPill" CornerRadius="20" Padding="12,5"
                            Background="{StaticResource AccentFaint}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}"
                                     VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock x:Name="StatusText" Text="已启用" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ToggleButton x:Name="MasterSwitch" Style="{StaticResource Switch}" Margin="14,0,0,0"
                                  Checked="Master_Toggled" Unchecked="Master_Toggled"
                                  ToolTip="总开关：关闭后滚轮完全按系统默认处理" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════ 左侧导航 + 内容 ══════════════ -->
        <TabControl x:Name="Nav" Grid.Row="1" Style="{StaticResource NavTabControl}"
                    ItemContainerStyle="{StaticResource NavTabItem}"
                    SelectionChanged="Nav_SelectionChanged">

            <!-- ─────────── 概览 ─────────── -->
            <TabItem Header="概览">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,18,24,26">

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="运行状态" Style="{StaticResource H2}" Margin="0,0,0,14" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="钩子" Style="{StaticResource Caption}" />
                                        <TextBlock x:Name="StatHook" Text="—" FontSize="15" FontWeight="SemiBold"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="当前目标应用" Style="{StaticResource Caption}" />
                                        <TextBlock x:Name="StatApp" Text="—" Style="{StaticResource Mono}"
                                                   FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="已接管 / 已放行" Style="{StaticResource Caption}" />
                                        <TextBlock x:Name="StatCount" Text="0 / 0" Style="{StaticResource Mono}"
                                                   FontWeight="SemiBold" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="当前滚动速度" Style="{StaticResource Caption}" />
                                        <TextBlock x:Name="StatRate" Text="—" Style="{StaticResource Mono}"
                                                   FontWeight="SemiBold" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="它是怎么做事的" Style="{StaticResource H2}" Margin="0,0,0,10" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                           Text="1 · 正常速度滚动时，程序什么都不做，事件原样交给 Windows —— 所以手感、精度、惯性都和你没装它时一模一样。" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                           Text="2 · 连续快速拨动滚轮时，速度超过阈值，程序接管这一次滚动，按设定倍率放大后再发出去，并可拆成多帧让画面顺滑推进。" />
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="3 · 松手后不再介入，速度掉回阈值以下就立刻回到完全原生的模式。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="行为" Style="{StaticResource H2}" Margin="0,0,0,6" />

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="开机自启" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}"
                                                   Text="登录时自动启动，直接待在托盘里，不弹窗。" />
                                    </StackPanel>
                                    <ToggleButton x:Name="AutoStartSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center" Checked="AutoStart_Changed"
                                                  Unchecked="AutoStart_Changed" />
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="关闭窗口时最小化到托盘" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}"
                                                   Text="关掉后点右上角 × 就是真的退出，增强也随之停止。" />
                                    </StackPanel>
                                    <ToggleButton x:Name="CloseToTraySwitch" Grid.Column="1"
                                                  Style="{StaticResource Switch}" VerticalAlignment="Center"
                                                  Checked="CloseToTray_Changed" Unchecked="CloseToTray_Changed" />
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="打开设置面板时暂停增强" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}"
                                                   Text="关掉时可以在本窗口里直接试手感；打开后本窗口的滚动也完全原生。" />
                                    </StackPanel>
                                    <ToggleButton x:Name="PauseSelfSwitch" Grid.Column="1"
                                                  Style="{StaticResource Switch}" VerticalAlignment="Center"
                                                  Checked="PauseSelf_Changed" Unchecked="PauseSelf_Changed" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ElevationCard" Style="{StaticResource Card}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="权限提示" Style="{StaticResource H2}" Margin="0,0,0,8"
                                           Foreground="{StaticResource WarnBrush}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12"
                                           Text="当前不是管理员身份。Windows 不允许普通程序拦截更高权限窗口的输入，所以「以管理员身份运行的窗口」里的滚轮不会被增强（任务管理器、部分游戏启动器、安装程序等）。" />
                                <Button Content="以管理员身份重启" Style="{StaticResource GhostButton}"
                                        HorizontalAlignment="Left" Click="RestartElevated_Click" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ─────────── 加速 ─────────── -->
            <TabItem Header="加速">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,18,24,26">

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="快速滚动加速" Style="{StaticResource H2}" />
                                        <TextBlock Style="{StaticResource Caption}"
                                                   Text="关闭后不再接管任何滚动事件（平滑也会随之失效）。" />
                                    </StackPanel>
                                    <ToggleButton x:Name="BoostSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center" Checked="Boost_Changed"
                                                  Unchecked="Boost_Changed" />
                                </Grid>

                                <!-- 倍率曲线预览 -->
                                <Border Style="{StaticResource InnerPanel}" Margin="0,16,0,0" Padding="14,12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="速度 → 倍率" Style="{StaticResource Caption}" />
                                            <TextBlock x:Name="CurveHint" Grid.Column="1" Style="{StaticResource Caption}"
                                                       Text="1 格 → 3.0 格" />
                                        </Grid>
                                        <Canvas x:Name="CurveCanvas" Height="112" Margin="0,8,0,0"
                                                ClipToBounds="True" SizeChanged="CurveCanvas_SizeChanged" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="触发阈值" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}"
                                                   Text="每秒滚多少格以上才算「快滚」。低于它的滚动完全交给系统，一个字节都不改。调高＝更不容易触发，调低＝轻轻一拨就加速。" />
                                    </StackPanel>
                                    <TextBlock x:Name="ThresholdValue" Grid.Column="1" Style="{StaticResource Value}"
                                               Text="10.0 格/秒" />
                                </Grid>
                                <Slider x:Name="ThresholdSlider" Style="{StaticResource HSlider}" Margin="0,10,0,0"
                                        Minimum="2" Maximum="25" SmallChange="0.5" LargeChange="1"
                                        ValueChanged="Threshold_Changed" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="满速点" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}"
                                                   Text="速度到多少格/秒时倍率已经吃满上限。它与触发阈值之间是平滑过渡，不是突变。" />
                                    </StackPanel>
                                    <TextBlock x:Name="SatValue" Grid.Column="1" Style="{StaticResource Value}"
                                               Text="40.0 格/秒" />
                                </Grid>
                                <Slider x:Name="SatSlider" Style="{StaticResource HSlider}" Margin="0,10,0,0"
                                        Minimum="12" Maximum="120" SmallChange="1" LargeChange="5"
                                        ValueChanged="Sat_Changed" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="加速倍率上限" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}"
                                                   Text="相对原始滚动速度的倍数：3.0 表示滚轮拨一格，页面滚动三格的距离。" />
                                    </StackPanel>
                                    <TextBlock x:Name="MaxMultValue" Grid.Column="1" Style="{StaticResource Value}"
                                               Text="3.0×" />
                                </Grid>
                                <Slider x:Name="MaxMultSlider" Style="{StaticResource HSlider}" Margin="0,10,0,0"
                                        Minimum="1" Maximum="8" SmallChange="0.1" LargeChange="0.5"
                                        ValueChanged="MaxMult_Changed" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="反向滚动时立刻纠正" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}"
                                                   Text="强烈建议保持开启。关闭后往回滚时，还没发完的旧方向积压会先冲完，手感像「滚不动」。" />
                                    </StackPanel>
                                    <ToggleButton x:Name="FlushReverseSwitch" Grid.Column="1"
                                                  Style="{StaticResource Switch}" VerticalAlignment="Center"
                                                  Checked="FlushReverse_Changed" Unchecked="FlushReverse_Changed" />
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="反转加速方向" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}"
                                                   Text="只给系统里设过「滚轮反向」的鼠标用。正常鼠标不要开，否则上下相反。" />
                                    </StackPanel>
                                    <ToggleButton x:Name="InvertSwitch" Grid.Column="1"
                                                  Style="{StaticResource Switch}" VerticalAlignment="Center"
                                                  Checked="Invert_Changed" Unchecked="Invert_Changed" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="也增强高精度输入" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}"
                                                   Text="触控板、自由滚轮、部分鼠标的精细档会发出很小的滚动量，本身已经很顺。默认不接管，打开可能导致这类设备滚动过快。" />
                                    </StackPanel>
                                    <ToggleButton x:Name="PrecisionSwitch" Grid.Column="1"
                                                  Style="{StaticResource Switch}" VerticalAlignment="Center"
                                                  Checked="Precision_Changed" Unchecked="Precision_Changed" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="默认值为什么是这样" Style="{StaticResource H2}" Margin="0,0,0,10" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                           Text="10 格/秒 ≈ 每 100ms 拨一格。正常浏览网页、看文档基本都在这个节奏以下，所以不会误触发；而想快速翻页时人会下意识连拨，节奏立刻就到 20 格/秒以上。" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                           Text="40 格/秒 ≈ 每 25ms 拨一格，是明显的甩动。把满速点放在这里，意味着「越用力甩，加速越充分」，同时避免轻轻一抖就顶格。" />
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="3 倍是绝大多数人不需要二次调整的值：一屏变三分之一的滚动量，又不会失控到找不到位置。觉得不够就调高，8 倍是上限。" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ─────────── 平滑 ─────────── -->
            <TabItem Header="平滑滚动">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,18,24,26">

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="平滑滚动" Style="{StaticResource H2}" />
                                        <TextBlock Style="{StaticResource Caption}"
                                                   Text="把一次滚动摊成多帧小步发出去，接近触控板那种连续顺滑的推进感。" />
                                    </StackPanel>
                                    <ToggleButton x:Name="SmoothSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center" Checked="Smooth_Changed"
                                                  Unchecked="Smooth_Changed" />
                                </Grid>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="施加范围" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}"
                                                   Text="「仅加速时」保持普通滚动 100% 原生，是默认也是推荐值；「所有滚动」会把普通滚动也拆帧重放。" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource SegGroup}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ScopeBoosted" GroupName="scope" Content="仅加速时"
                                                         Style="{StaticResource SegRadio}" Checked="Scope_Changed" />
                                            <RadioButton x:Name="ScopeAlways" GroupName="scope" Content="所有滚动"
                                                         Style="{StaticResource SegRadio}" Checked="Scope_Changed" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="注入帧率" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}"
                                                   Text="每秒发多少小步。120 已经很顺；越高越耗电，笔记本上没必要上 144。" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource SegGroup}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="Fps60" GroupName="fps" Content="60"
                                                         Style="{StaticResource SegRadio}" Checked="Fps_Changed" />
                                            <RadioButton x:Name="Fps90" GroupName="fps" Content="90"
                                                         Style="{StaticResource SegRadio}" Checked="Fps_Changed" />
                                            <RadioButton x:Name="Fps120" GroupName="fps" Content="120"
                                                         Style="{StaticResource SegRadio}" Checked="Fps_Changed" />
                                            <RadioButton x:Name="Fps144" GroupName="fps" Content="144"
                                                         Style="{StaticResource SegRadio}" Checked="Fps_Changed" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="每格拆分" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}"
                                                   Text="一格（120 单位）拆成几帧发。4 表示每帧 30 单位——正好整除，老程序也不会丢量。数值越大越细腻。" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource SegGroup}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="Fpn2" GroupName="fpn" Content="2"
                                                         Style="{StaticResource SegRadio}" Checked="Fpn_Changed" />
                                            <RadioButton x:Name="Fpn3" GroupName="fpn" Content="3"
                                                         Style="{StaticResource SegRadio}" Checked="Fpn_Changed" />
                                            <RadioButton x:Name="Fpn4" GroupName="fpn" Content="4"
                                                         Style="{StaticResource SegRadio}" Checked="Fpn_Changed" />
                                            <RadioButton x:Name="Fpn6" GroupName="fpn" Content="6"
                                                         Style="{StaticResource SegRadio}" Checked="Fpn_Changed" />
                                            <RadioButton x:Name="Fpn8" GroupName="fpn" Content="8"
                                                         Style="{StaticResource SegRadio}" Checked="Fpn_Changed" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="惯性长度（时间常数）" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}"
                                                   Text="越大尾巴越长、越「绵」；越小越干脆利落。30~60 之间最像触控板。" />
                                    </StackPanel>
                                    <TextBlock x:Name="TauValue" Grid.Column="1" Style="{StaticResource Value}"
                                               Text="45 ms" />
                                </Grid>
                                <Slider x:Name="TauSlider" Style="{StaticResource HSlider}" Margin="0,10,0,0"
                                        Minimum="5" Maximum="120" SmallChange="1" LargeChange="5"
                                        ValueChanged="Tau_Changed" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="最大延迟" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}"
                                                   Text="一次滚动最多拖这么久必须发完。这是体感延迟的硬上限，调大平滑更明显但会有「跟不上手」的感觉。" />
                                    </StackPanel>
                                    <TextBlock x:Name="LatencyValue" Grid.Column="1" Style="{StaticResource Value}"
                                               Text="60 ms" />
                                </Grid>
                                <Slider x:Name="LatencySlider" Style="{StaticResource HSlider}" Margin="0,10,0,0"
                                        Minimum="16" Maximum="200" SmallChange="2" LargeChange="10"
                                        ValueChanged="Latency_Changed" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="积压上限" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}"
                                                   Text="连续甩动时允许攒着还没发完的量。超过就把剩余量一次性发出去，避免页面在你停手之后还在往前飘。" />
                                    </StackPanel>
                                    <TextBlock x:Name="BacklogValue" Grid.Column="1" Style="{StaticResource Value}"
                                               Text="5 格" />
                                </Grid>
                                <Slider x:Name="BacklogSlider" Style="{StaticResource HSlider}" Margin="0,10,0,0"
                                        Minimum="1" Maximum="20" SmallChange="1" LargeChange="2"
                                        ValueChanged="Backlog_Changed" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ─────────── 应用名单 ─────────── -->
            <TabItem Header="应用名单">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,18,24,26">

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="名单模式" Style="{StaticResource H2}" Margin="0,0,0,4" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,14"
                                           Text="先决定名单是「排除」用的还是「只允许」用的，再往里面加程序。改动即时生效，不用重启。" />
                                <Border Style="{StaticResource SegGroup}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ModeBlack" GroupName="mode" Content="黑名单（名单里的不增强）"
                                                     Style="{StaticResource SegRadio}" Checked="Mode_Changed" />
                                        <RadioButton x:Name="ModeWhite" GroupName="mode" Content="白名单（只增强名单里的）"
                                                     Style="{StaticResource SegRadio}" Checked="Mode_Changed" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="添加应用" Style="{StaticResource H2}" Margin="0,0,0,4" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12"
                                           Text="按进程名（exe 文件名）匹配，不区分大小写。可以直接粘贴完整路径，会自动只留文件名。" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="AddAppBox" Style="{StaticResource DarkTextBox}"
                                             ToolTip="例如 chrome.exe" />
                                    <Button Grid.Column="1" x:Name="PickRunningBtn" Content="从运行中的应用选择"
                                            Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Click="PickRunning_Click" />
                                    <Button Grid.Column="2" Content="添加" Style="{StaticResource PrimaryButton}"
                                            Margin="8,0,0,0" Click="AddApp_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="当前名单" Style="{StaticResource H2}" />
                                    <TextBlock x:Name="AppsCount" Grid.Column="1" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" Text="0 项" />
                                </Grid>
                                <ListBox x:Name="AppsList" Style="{StaticResource PlainListBox}"
                                         ItemContainerStyle="{StaticResource PlainListBoxItem}" MaxHeight="330">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Exe}" Style="{StaticResource Mono}"
                                                               FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="✕" Style="{StaticResource TinyButton}"
                                                        Tag="{Binding Exe}" Click="RemoveApp_Click"
                                                        ToolTip="从名单移除" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="AppsEmpty" Style="{StaticResource Caption}" Visibility="Collapsed"
                                           Text="名单是空的。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="按窗口标题匹配（可选）" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,10"
                                           Text="一个正则表达式，不区分大小写。命中同样按名单模式处理。留空即关闭。例如 remote|远程 可以把所有远程桌面窗口排除掉。" />
                                <TextBox x:Name="TitleRegexBox" Style="{StaticResource DarkTextBox}"
                                         TextChanged="TitleRegex_Changed" />
                                <TextBlock x:Name="RegexHint" Style="{StaticResource Caption}" Margin="0,8,0,0"
                                           Visibility="Collapsed" Foreground="{StaticResource DangerBrush}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ─────────── 更新 ─────────── -->
            <TabItem Header="更新">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,18,24,26">

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="启动时自动检查更新" Style="{StaticResource H2}" />
                                        <TextBlock Style="{StaticResource Caption}"
                                                   Text="打开后每次启动在后台静默查一次；已是最新版时不弹任何东西。" />
                                    </StackPanel>
                                    <ToggleButton x:Name="AutoCheckSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center" Checked="AutoCheck_Changed"
                                                  Unchecked="AutoCheck_Changed" />
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="当前版本" Style="{StaticResource Caption}" />
                                        <TextBlock x:Name="CurrentVersionText" Text="—" Style="{StaticResource Mono}"
                                                   FontWeight="SemiBold" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="更新来源仓库" Style="{StaticResource Caption}"
                                                   HorizontalAlignment="Right" />
                                        <Button x:Name="RepoLink" Style="{StaticResource LinkButton}"
                                                HorizontalAlignment="Right" Margin="0,3,0,0" Click="OpenRepo_Click">
                                            <TextBlock x:Name="RepoText" Style="{StaticResource Mono}" FontSize="11.5"
                                                       Foreground="{StaticResource AccentHover}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button x:Name="CheckBtn" Content="检查更新" Style="{StaticResource PrimaryButton}"
                                            Click="CheckUpdate_Click" />
                                    <Button x:Name="DownloadBtn" Content="下载并安装" Style="{StaticResource GhostButton}"
                                            Margin="10,0,0,0" Click="DownloadUpdate_Click" Visibility="Collapsed" />
                                    <Button x:Name="CancelBtn" Content="取消下载" Style="{StaticResource GhostButton}"
                                            Margin="10,0,0,0" Click="CancelDownload_Click" Visibility="Collapsed" />
                                    <Button x:Name="RestartBtn" Content="立即重启以完成更新"
                                            Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                            Click="Restart_Click" Visibility="Collapsed" />
                                </StackPanel>

                                <ProgressBar x:Name="UpdateProgress" Style="{StaticResource DarkProgress}"
                                             Margin="0,16,0,0" Visibility="Collapsed" Minimum="0" Maximum="100" />
                                <TextBlock x:Name="UpdateStatus" Style="{StaticResource Caption}" Margin="0,10,0,0"
                                           Text="点「检查更新」看看有没有新版本。" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="NotesCard" Style="{StaticResource Card}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="NotesTitle" Text="更新说明" Style="{StaticResource H2}"
                                           Margin="0,0,0,8" />
                                <TextBox x:Name="NotesBox" Style="{StaticResource DarkTextBox}" IsReadOnly="True"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="150"
                                         VerticalScrollBarVisibility="Auto" FontSize="11.5" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="GitHub 个人访问令牌" Style="{StaticResource H2}" Margin="0,0,0,4" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6"
                                           Text="选填，但强烈建议填。没填时查版本走匿名接口，每小时只有 60 次额度，而且很容易被限流；填了是 5000 次/小时。" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12">
                                    <Run Text="生成方式：GitHub → Settings → Developer settings → Personal access tokens。" />
                                    <Run Text="公开仓库的只读访问，classic 令牌连 scope 都不用勾；fine-grained 令牌只需对该仓库授予 Contents 只读。" />
                                </TextBlock>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TokenBox" Style="{StaticResource DarkTextBox}"
                                             ToolTip="粘贴后点「保存令牌」" />
                                    <Button Grid.Column="1" x:Name="EditTokenBtn" Content="更换"
                                            Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="EditToken_Click"
                                            Visibility="Collapsed" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="SaveTokenBtn" Content="保存令牌" Style="{StaticResource PrimaryButton}"
                                            Click="SaveToken_Click" />
                                    <Button x:Name="VerifyTokenBtn" Content="验证" Style="{StaticResource GhostButton}"
                                            Margin="10,0,0,0" Click="VerifyToken_Click" />
                                    <Button x:Name="ClearTokenBtn" Content="清除" Style="{StaticResource DangerButton}"
                                            Margin="10,0,0,0" Click="ClearToken_Click" Visibility="Collapsed" />
                                </StackPanel>

                                <TextBlock x:Name="TokenStatus" Style="{StaticResource Caption}" Margin="0,10,0,0"
                                           Text="令牌只会以 DPAPI 加密后保存在本机配置文件里，不会上传、不会写进日志。" />

                                <Border Style="{StaticResource InnerPanel}" Margin="0,12,0,0">
                                    <TextBlock x:Name="RateText" Style="{StaticResource Caption}"
                                               Text="接口额度：点「验证」可以查看这个令牌本小时还剩多少次。" />
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ─────────── 帮助 ─────────── -->
            <TabItem Header="帮助">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,18,24,26">

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="这个软件是干什么的" Style="{StaticResource H2}" Margin="0,0,0,10" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                           Text="鼠标滚轮增强（Mouse wheel enhancement）只解决一个具体问题：滚轮在「需要快速翻很远」的时候太慢。" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                           Text="它不改你的鼠标设置、不改系统滚动行数、不装驱动。它只在你快速连续拨动滚轮的那一瞬间介入，把这一段滚动的距离按倍率放大；你一放慢，它立刻退场，把控制权原样交回 Windows。" />
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="另外还提供两件事：一是可选的平滑滚动（把一次滚动拆成多帧推进，接近触控板手感），二是按应用的黑白名单（哪些软件里启用、哪些禁用）。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="三条核心规则" Style="{StaticResource H2}" Margin="0,0,0,10" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                           Text="① 慢速滚动＝完全原生。程序在钩子里判定「这一下不需要接管」时直接放行，不做任何重发。所以普通滚动的手感、精度、平滑度、惯性与你没装这个软件时完全一致。" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                           Text="② 快滚才加速。判定依据是「每秒滚多少格」，不是「第几格」。速度超过触发阈值后开始介入，倍率随速度平滑爬到上限。" />
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="③ 随时可退出链路。总开关关掉、名单命中、按住 Ctrl/Alt/Shift、或反向滚动纠正时，都立刻回到原生行为。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="加速参数逐个说" Style="{StaticResource H2}" Margin="0,0,0,12" />

                                <TextBlock Text="触发阈值（默认 10 格/秒）" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12"
                                           Text="每秒滚过多少格以上才认为你在快滚。一格＝滚轮物理上的一响。10 格/秒约等于每 100 毫秒拨一格。调高→更保守，几乎不会误触发；调低→轻轻一拨就加速，但浏览长文时容易「窜」。可行范围 2~25。" />

                                <TextBlock Text="满速点（默认 40 格/秒）" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12"
                                           Text="速度到这里时倍率已经吃满上限。触发阈值与满速点之间用平滑曲线过渡，所以加速是渐进的、没有台阶。这两点靠得越近，加速来得越突然。可行范围 12~120，且必须高于触发阈值。" />

                                <TextBlock Text="加速倍率上限（默认 3.0×）" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12"
                                           Text="相对原始滚动速度的倍数。3.0 表示滚轮拨一格、页面滚动三格的距离；2.0 是两倍；8.0 是上限。这是上限而不是固定值——只有当你的滚动速度达到满速点时才会真正用满。" />

                                <TextBlock Text="反向滚动时立刻纠正（默认开）" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12"
                                           Text="平滑会把一次滚动分成多帧慢慢发。若攒着一堆「向下」还没发完，你却开始「向上」滚，那些旧方向会继续冲完，手感像「滚不动」。开启后方向一变就丢掉旧积压，立刻响应。" />

                                <TextBlock Text="反转加速方向（默认关）" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12"
                                           Text="只给在 Windows 里勾了「滚轮反向」的鼠标用。正常鼠标打开会导致上下相反。" />

                                <TextBlock Text="也增强高精度输入（默认关）" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="触控板、自由滚轮、部分鼠标的精细档每次只发很小的滚动量，且频率极高。它们本身已经很顺，按「每秒格数」去算会被判成狂甩而加速过头，所以默认一律放行。只有你确定希望这类设备也加速时才打开。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="平滑参数逐个说" Style="{StaticResource H2}" Margin="0,0,0,12" />

                                <TextBlock Text="施加范围（默认：仅加速时）" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12"
                                           Text="「仅加速时」意味着普通滚动完全不经过本程序，这是保住原生手感的关键；「所有滚动」会把普通滚动也拆帧重放，观感更统一，但严格来说已经不是原生行为了。" />

                                <TextBlock Text="注入帧率（默认 120）" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12"
                                           Text="每秒发多少个小步。60 已经能看出平滑，120 基本无缝，144 提升很小但更耗电。" />

                                <TextBlock Text="每格拆分（默认 4）" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12"
                                           Text="一格 120 单位拆成几帧发。选 4 则每帧 30 单位，4×30＝120 正好整除，连按「除以 120 取整」处理滚动量的老程序也不会把小数吃掉。数值越大越细腻，但太大会让单帧量小到某些程序直接忽略。" />

                                <TextBlock Text="惯性长度（默认 45ms）" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12"
                                           Text="指数衰减的时间常数，决定「尾巴」有多长。30~60ms 最接近触控板；调到 10ms 几乎等于关掉平滑，调到 120ms 会有明显滑行感。" />

                                <TextBlock Text="最大延迟（默认 60ms）" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12"
                                           Text="一次输入最多拖这么久必须发完，是体感延迟的硬上限。它是保险：无论惯性长度调多大，页面的反应都不会超过这个时间才开始。" />

                                <TextBlock Text="积压上限（默认 5 格）" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="连续甩动时允许暂存还没发完的量。超过上限就把剩余量一次性冲出，避免你停手之后页面还在继续飘。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="应用名单怎么用" Style="{StaticResource H2}" Margin="0,0,0,12" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                                           Text="黑名单（默认）：名单里的程序不增强，其他全部增强。适合「个别软件里别烦我」。" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                                           Text="白名单：只有名单里的程序增强。适合「平时都别动，我只在浏览器里用」。" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                                           Text="按 exe 文件名匹配，不区分大小写，粘贴完整路径会自动只取文件名。托盘右键菜单里有「加入/移出黑名单：当前应用」，不用回设置页。" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                                           Text="默认黑名单已排除远程桌面（注入会和控制端滚动叠加）、音游与竞技游戏（时序敏感、反作弊对注入敏感）。" />
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="判定依据是「光标下那个窗口」所属的进程，而不是任务栏里的前台窗口——因为 Windows 默认把滚轮发给光标下的窗口，哪怕它没有激活。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="更新与令牌" Style="{StaticResource H2}" Margin="0,0,0,12" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                                           Text="更新走 GitHub Releases：点「检查更新」会比对最新正式版；发现有新版可在程序内直接下载、校验 SHA256、替换旧程序并重启，不需要跳浏览器。" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                                           Text="令牌是选填的。不填也能查更新和下载，只是查版本走匿名接口，每小时只有 60 次额度，容易被限流；填了是每小时 5000 次。" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                                           Text="令牌只以 DPAPI 加密保存在本机配置文件里，只有当前 Windows 账户能解开，不上传、不写日志。填错或过期时程序会自动降级成匿名请求，不会让更新功能整个坏掉。" />
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="换仓库时不必改代码：配置文件里 update.repo 填 owner/repo 即可。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="常见问题" Style="{StaticResource H2}" Margin="0,0,0,12" />

                                <TextBlock Text="某些窗口里完全没效果？" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12"
                                           Text="那个窗口大概率是以管理员身份运行的。Windows 的安全机制（UIPI）不允许普通权限的钩子拦截高权限窗口的输入。在「概览」页点「以管理员身份重启」即可覆盖这类窗口。" />

                                <TextBlock Text="全屏游戏里无效？" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12"
                                           Text="用 Raw Input / DirectInput 独占总线的游戏绕过系统鼠标钩子，任何基于 SetWindowsHookEx 的工具都拿不到事件。这是技术边界，不是配置问题；默认名单也已把常见竞技游戏排除。" />

                                <TextBlock Text="笔记本触控板两指滚动没变化？" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12"
                                           Text="这是刻意的：高精度输入默认不接管。见「也增强高精度输入」这一项。" />

                                <TextBlock Text="Ctrl + 滚轮缩放会不会被加速？" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12"
                                           Text="不会。按住 Ctrl 或 Alt 的滚轮一律原样放行，缩放必须 1:1。Shift + 滚轮（横向滚动）同样放行。" />

                                <TextBlock Text="用着用着突然失灵？" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="Windows 在钩子回调超时会静默摘掉钩子且不作提示。到「关于」页点「重启钩子」即可恢复；日志里会留下记录。" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ─────────── 关于 ─────────── -->
            <TabItem Header="关于">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,18,24,26">

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Width="52" Height="52" CornerRadius="13"
                                            Background="{StaticResource AccentSoft}" Margin="0,0,16,0">
                                        <TextBlock Text="⟳" FontSize="26" Foreground="{StaticResource AccentHover}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="鼠标滚轮增强" Style="{StaticResource H1}" />
                                        <TextBlock Text="Mouse wheel enhancement" Style="{StaticResource Caption}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="当前版本" Style="{StaticResource Caption}" />
                                    <TextBlock x:Name="AboutVersion" Grid.Column="1" Style="{StaticResource Mono}"
                                               FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="开发者" Style="{StaticResource Caption}" />
                                    <TextBlock x:Name="AboutAuthor" Grid.Column="1" Style="{StaticResource Mono}"
                                               FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="项目主页" Style="{StaticResource Caption}" />
                                    <Button x:Name="HomeBtn" Grid.Column="1" Style="{StaticResource LinkButton}"
                                            HorizontalAlignment="Left" Click="OpenHome_Click">
                                        <TextBlock x:Name="HomeText" Style="{StaticResource Mono}" FontSize="12"
                                                   Foreground="{StaticResource AccentHover}" />
                                    </Button>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="GitHub" Style="{StaticResource Caption}" />
                                    <Button x:Name="GitHubBtn" Grid.Column="1" Style="{StaticResource LinkButton}"
                                            HorizontalAlignment="Left" Click="OpenGitHub_Click"
                                            ToolTip="git clone git@github.com:QQQOrange/Mouse-wheel-enhancement.git">
                                        <TextBlock x:Name="GitHubText" Style="{StaticResource Mono}" FontSize="12"
                                                   Foreground="{StaticResource AccentHover}" />
                                    </Button>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="发布页面" Style="{StaticResource Caption}" />
                                    <Button x:Name="ReleasesBtn" Grid.Column="1" Style="{StaticResource LinkButton}"
                                            HorizontalAlignment="Left" Click="OpenReleases_Click">
                                        <TextBlock x:Name="ReleasesText" Style="{StaticResource Mono}" FontSize="12"
                                                   Foreground="{StaticResource AccentHover}" />
                                    </Button>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="许可证" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Mono}"
                                               Foreground="{StaticResource TextPrimary}" Text="MIT License" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="文件与诊断" Style="{StaticResource H2}" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="数据目录" Style="{StaticResource Caption}" />
                                    <TextBlock x:Name="AboutDataDir" Grid.Column="1" Style="{StaticResource Mono}"
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <Button Grid.Column="2" Content="打开" Style="{StaticResource GhostButton}"
                                            Click="OpenDataDir_Click" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="日志" Style="{StaticResource Caption}" />
                                    <TextBlock x:Name="AboutLogPath" Grid.Column="1" Style="{StaticResource Mono}"
                                               FontSize="11" TextWrapping="Wrap" />
                                    <Button Grid.Column="2" Content="打开" Style="{StaticResource GhostButton}"
                                            Click="OpenLog_Click" />
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="运行权限" Style="{StaticResource Caption}" />
                                    <TextBlock x:Name="AboutElevation" Grid.Column="1" Style="{StaticResource Mono}"
                                               FontSize="11.5" />
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="RestartHookBtn" Content="重启钩子" Style="{StaticResource GhostButton}"
                                            Click="RestartHook_Click" />
                                    <Button Content="打开配置文件夹" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                            Click="OpenDataDir_Click" />
                                    <Button Content="恢复默认设置" Style="{StaticResource DangerButton}" Margin="10,0,0,0"
                                            Click="ResetDefaults_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- ══════════════ 底部 ══════════════ -->
        <Border Grid.Row="2" Background="{StaticResource PanelBg}" BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource BorderBrushSoft}" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Click="OpenDataDir_Click"
                        ToolTip="点击打开数据目录">
                    <TextBlock x:Name="FooterDataDir" Style="{StaticResource Mono}" FontSize="10.5"
                               TextTrimming="CharacterEllipsis" MaxWidth="520" />
                </Button>
                <TextBlock x:Name="FooterRight" Grid.Column="1" Style="{StaticResource Caption}" FontSize="10.5"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
