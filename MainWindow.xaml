<Window x:Class="MouseWheelEnhancement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="鼠标滚轮增强" Height="830" Width="1120" MinHeight="680" MinWidth="1000"
        Background="{DynamicResource WindowGradient}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextElement.Foreground="{DynamicResource TextPrimary}"
        TextOptions.TextFormattingMode="Display">

    <!--
        ══════════════ 自绘标题栏 ══════════════

        用 WindowChrome 把系统标题栏换成自己的：左侧品牌栏贯穿整个窗口高度，
        右侧顶部 56px 是标题栏（页面名 + 版本徽标 + 总开关 + 三个图标按钮）。

        几个必须记住的点：
          · CaptionHeight=56 —— 这 56px 内由系统负责拖动/双击最大化；
            里面的按钮必须写 WindowChrome.IsHitTestVisibleInChrome="True"，
            否则点不动（事件被拖动逻辑吃掉）。
          · ResizeBorderThickness=6 —— 自绘标题栏之后，四周的缩放边框要靠它，
            否则窗口没法拉大拉小。
          · GlassFrameThickness=0 —— 不要 Aero 玻璃，背景全部由我们的渐变铺满。
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════ 左侧栏：品牌 + 导航 + 状态 ══════════════
             外框左角由代码按需打成圆角（ApplyWindowCorner）：
             只有 Win11 上窗口真的圆了才打，避免"窗口方、侧栏圆"。 -->
        <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 品牌 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="18,18,12,18">
                    <Border Width="40" Height="40" CornerRadius="11" VerticalAlignment="Center"
                            Background="{DynamicResource AccentSoft}"
                            BorderBrush="{DynamicResource AccentSoftBorder}" BorderThickness="1">
                        <TextBlock Text="&#x27F3;" FontSize="19" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentHover}" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="鼠标滚轮增强" Style="{StaticResource H3}" />
                        <TextBlock x:Name="SubtitleText" Style="{StaticResource Caption}" FontSize="11"
                                   Margin="0,1,0,0" Text="Mouse wheel enhancement" />
                    </StackPanel>
                </StackPanel>

                <!-- 导航 -->
                <ListBox Grid.Row="1" x:Name="NavList" Style="{StaticResource PlainListBox}"
                         ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBoxItem Tag="&#xE80F;" Content="概览" />
                    <ListBoxItem Tag="&#xE945;" Content="加速" />
                    <ListBoxItem Tag="&#xE9D2;" Content="平滑滚动" />
                    <ListBoxItem Tag="&#xE77F;" Content="应用名单" />
                    <ListBoxItem Tag="&#xE753;" Content="更新" />
                    <ListBoxItem Tag="&#xE897;" Content="帮助" />
                    <ListBoxItem Tag="&#xE946;" Content="关于" />
                </ListBox>

                <!-- 状态卡 -->
                <Border Grid.Row="2" Style="{StaticResource StatusCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{DynamicResource SuccessBrush}" />
                            <TextBlock x:Name="StatusText" Text="已启用" Margin="7,0,0,0" FontSize="12.5" />
                        </StackPanel>
                        <TextBlock x:Name="HookHint" Style="{StaticResource Caption}" FontSize="11" Margin="0,4,0,0"
                                   Text="滚轮钩子正常" />
                        <TextBlock x:Name="StatusToday" Style="{StaticResource Caption}" FontSize="11" Margin="0,3,0,0"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="本次已接管 0 次" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════ 右侧：标题栏 + 页面 + 底栏 ══════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" Text="概览" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource Badge}" Margin="10,0,0,0">
                        <TextBlock x:Name="PageBadge" Style="{StaticResource BadgeText}" Text="—" />
                    </Border>
                    <Border x:Name="StatusPill" Style="{StaticResource Badge}" Margin="8,0,0,0">
                        <TextBlock x:Name="StatusPillText" Style="{StaticResource BadgeText}" Text="增强中" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="启用" Style="{StaticResource Caption}" VerticalAlignment="Center"
                               Margin="0,0,9,0" />
                    <ToggleButton x:Name="MasterSwitch" Style="{StaticResource Switch}"
                                  Checked="Master_Toggled" Unchecked="Master_Toggled"
                                  AutomationProperties.Name="启用滚轮增强"
                                  ToolTip="总开关：关闭后滚轮完全按系统默认处理" />
                    <Border Width="1" Height="18" Margin="13,0,7,0"
                            Background="{DynamicResource BorderBrushSoft}" />
                    <Button x:Name="ThemeBtn" Style="{StaticResource IconButton}"
                            Click="ThemeBtn_Click" AutomationProperties.Name="切换深浅色"
                            ToolTip="切换深浅色">
                        <TextBlock x:Name="ThemeGlyph" Text="&#xE793;" Style="{StaticResource IconGlyph}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            Click="Minimize_Click" AutomationProperties.Name="最小化窗口"
                            ToolTip="最小化">
                        <TextBlock Text="&#xE921;" Style="{StaticResource IconGlyph}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            Click="Close_Click" AutomationProperties.Name="关闭到托盘"
                            ToolTip="关闭到托盘">
                        <TextBlock Text="&#xE8BB;" Style="{StaticResource IconGlyph}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ══════════════ 页面内容 ══════════════
                 导航由左侧 ListBox 驱动；这里的 TabControl 只负责"哪一页可见"，
                 它的模板里没有标签条 —— 否则会多出一条无用的横排标签。
                 TabItem 的 Header 仍是纯文本：标题栏用它显示当前页名。 -->
            <TabControl x:Name="Nav" Grid.Row="1" Background="Transparent" BorderThickness="0"
                        SelectedIndex="0" SelectionChanged="Nav_SelectionChanged">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent" />
                    </ControlTemplate>
                </TabControl.Template>

            <!-- ─────────── 概览 ─────────── -->
            <TabItem Header="概览">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,18,24,26">

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="运行状态" Style="{StaticResource H2}" Margin="0,0,0,14" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="钩子" Style="{StaticResource Caption}" />
                                        <TextBlock x:Name="StatHook" Text="—" FontSize="15" FontWeight="SemiBold"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="当前目标应用" Style="{StaticResource Caption}" />
                                        <TextBlock x:Name="StatApp" Text="—" Style="{StaticResource Mono}"
                                                   FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="已接管 / 已放行" Style="{StaticResource Caption}" />
                                        <TextBlock x:Name="StatCount" Text="0 / 0" Style="{StaticResource Mono}"
                                                   FontWeight="SemiBold" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="当前滚动速度" Style="{StaticResource Caption}" />
                                        <TextBlock x:Name="StatRate" Text="—" Style="{StaticResource Mono}"
                                                   FontWeight="SemiBold" Margin="0,4,0,0" />
                                        <ProgressBar x:Name="RateBar" Style="{StaticResource DarkProgress}"
                                                     Minimum="0" Maximum="40" Value="0" Height="3" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="最近识别的程序" Style="{StaticResource H2}" Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10" TextWrapping="Wrap"
                                           Text="每个程序用的是哪种滚动语义，一眼可查。手感不对时看这里：显示「按事件」的程序不能摊帧，「自带平滑」的交还给应用。" />
                                <StackPanel x:Name="RecentPanel" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="它是怎么做事的" Style="{StaticResource H2}" Margin="0,0,0,10" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                           Text="1 · 滚动事件先经过本程序：量是多少、按什么节奏发，由下面的参数决定。默认「所有滚动」都接管，慢慢拨一格也是分成几小步滑上去，不再是一跳。" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                           Text="2 · 连续快速拨动滚轮、速度超过阈值时，在平滑的基础上再按倍率放大 —— 长页面几下就能到底。" />
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="3 · 松手后不立刻收工：剩下的量按惯性慢慢衰减发完，所以停的时候是滑到尾而不是咔一下停住。想完全回到原生手感，把「平滑滚动」整个关掉即可。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="行为" Style="{StaticResource H2}" Margin="0,0,0,6" />

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="开机自启" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}"
                                                   Text="登录时自动启动，直接待在托盘里，不弹窗。" />
                                    </StackPanel>
                                    <ToggleButton x:Name="AutoStartSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center" Checked="AutoStart_Changed"
                                                  Unchecked="AutoStart_Changed" />
                                </Grid>

                                <!--
                                    「以管理员身份运行」**不再从属于**「开机自启」：
                                    它管的是每一次启动（手动双击也会提权），
                                    有人就想要"平时以管理员跑，但别开机自己启动"。
                                -->
                                <Grid x:Name="AdminStartRow" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="14,0,10,0">
                                        <TextBlock Text="以管理员身份运行" FontWeight="SemiBold" />
                                        <TextBlock x:Name="AdminStartHint" Style="{StaticResource Caption}"
                                                   TextWrapping="Wrap"
                                                   Text="每次启动都以管理员身份运行。开机那次由计划任务直接给权限、不弹确认；手动打开时系统会问一次。" />
                                    </StackPanel>
                                    <ToggleButton x:Name="AdminStartSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center"
                                                  Checked="AdminStart_Changed" Unchecked="AdminStart_Changed" />
                                </Grid>

                                <!--
                                    任务失效提示。

                                    平时这一整块是 Collapsed —— 它只在"开关显示着开、开机却起不来"
                                    的时候才出现。之所以要有它：计划任务指向的文件被删掉时，
                                    系统不会报任何错，开关也照样是"开"的，用户根本无从察觉
                                    （实测：任务指向 app\1.4.0\，那个目录早被升级清理了，
                                     任务结果码 0x41303 = 从未运行）。
                                -->
                                <Border x:Name="AdminStartBrokenBar" Visibility="Collapsed" Margin="0,12,0,0"
                                        CornerRadius="10" Padding="12,9"
                                        Background="{DynamicResource AccentFaint}"
                                        BorderBrush="{DynamicResource WarnBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="AdminStartBrokenText" Style="{StaticResource Caption}"
                                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   Text="开机自启任务已失效：它指向的程序文件已经不存在（多半是升级后旧版本目录被清理了），下次开机不会自动启动。点「立即修复」重建它。" />
                                        <Button x:Name="AdminStartFixBtn" Grid.Column="1" Margin="14,0,0,0"
                                                VerticalAlignment="Center" Style="{StaticResource PrimaryButton}"
                                                Content="立即修复" Click="AdminStartFix_Click" />
                                    </Grid>
                                </Border>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="关闭窗口时最小化到托盘" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}"
                                                   Text="关掉后点右上角 × 就是真的退出，增强也随之停止。" />
                                    </StackPanel>
                                    <ToggleButton x:Name="CloseToTraySwitch" Grid.Column="1"
                                                  Style="{StaticResource Switch}" VerticalAlignment="Center"
                                                  Checked="CloseToTray_Changed" Unchecked="CloseToTray_Changed" />
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="在本窗口暂停增强" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                   Text="默认关闭 —— 设置窗口里的滚动同样会被增强，可以直接在这里试手感。只有想对比「原生 vs 增强」时才需要打开。" />
                                    </StackPanel>
                                    <ToggleButton x:Name="PauseSelfSwitch" Grid.Column="1"
                                                  Style="{StaticResource Switch}" VerticalAlignment="Center"
                                                  Checked="PauseSelf_Changed" Unchecked="PauseSelf_Changed" />
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Shift + 滚轮横向加速" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                   Text="宽表格、代码 diff、时间轴这类横向内容，按住 Shift 快拨时同样放大位移。横向没有平滑，只更快。" />
                                    </StackPanel>
                                    <ToggleButton x:Name="HorizontalSwitch" Grid.Column="1"
                                                  Style="{StaticResource Switch}" VerticalAlignment="Center"
                                                  Checked="Horizontal_Changed" Unchecked="Horizontal_Changed" />
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="加速时显示倍率" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                   Text="快速滚动时在光标旁闪一下当前倍率（如 3.2×），300 毫秒后淡出。不抢焦点、点不中。" />
                                    </StackPanel>
                                    <ToggleButton x:Name="OsdSwitch" Grid.Column="1"
                                                  Style="{StaticResource Switch}" VerticalAlignment="Center"
                                                  Checked="Osd_Changed" Unchecked="Osd_Changed" />
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="钩子看门狗" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                   Text="Windows 有时会静默摘掉钩子（表现是用着用着突然不加速）。开启后会自动发现并恢复，长期不用时也会换一个新钩子。" />
                                    </StackPanel>
                                    <ToggleButton x:Name="WatchdogSwitch" Grid.Column="1"
                                                  Style="{StaticResource Switch}" VerticalAlignment="Center"
                                                  Checked="Watchdog_Changed" Unchecked="Watchdog_Changed" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="外观" Style="{StaticResource H2}" />
                                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                   Text="默认跟随系统：Windows 切成深色，这里跟着变，不用重启。也可以固定成浅色或深色。" />
                                    </StackPanel>
                                    <TextBlock x:Name="ThemeNow" Grid.Column="1" Style="{StaticResource Caption}"
                                               VerticalAlignment="Top" Margin="12,2,0,0" Text="—" />
                                </Grid>

                                <Border Style="{StaticResource SegGroup}" HorizontalAlignment="Left" Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ThemeSystem" GroupName="theme" Content="跟随系统"
                                                     Style="{StaticResource SegRadio}" Checked="Theme_Changed" />
                                        <RadioButton x:Name="ThemeLight" GroupName="theme" Content="浅色"
                                                     Style="{StaticResource SegRadio}" Checked="Theme_Changed" />
                                        <RadioButton x:Name="ThemeDark" GroupName="theme" Content="深色"
                                                     Style="{StaticResource SegRadio}" Checked="Theme_Changed" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ElevationCard" Style="{StaticResource Card}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="权限提示" Style="{StaticResource H2}" Margin="0,0,0,8"
                                           Foreground="{DynamicResource WarnBrush}" />
                                <TextBlock x:Name="ElevationHint" Style="{StaticResource Caption}" Margin="0,0,0,12"
                                           TextWrapping="Wrap"
                                           Text="当前不是管理员身份。Windows 不允许普通程序拦截更高权限窗口的输入，所以「以管理员身份运行的窗口」里的滚轮不会被增强（任务管理器、部分游戏启动器、安装程序等）。" />
                                <Button Content="以管理员身份重启" Style="{StaticResource GhostButton}"
                                        HorizontalAlignment="Left" Click="RestartElevated_Click" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ─────────── 加速 ─────────── -->
            <TabItem x:Name="AccelerationTab" Header="加速" />

            <!-- ─────────── 平滑 ─────────── -->
            <TabItem x:Name="SmoothTab" Header="平滑滚动" />

            <!-- ─────────── 应用名单 ─────────── -->
            <TabItem x:Name="AppsTab" Header="应用名单" />

            <!-- ─────────── 更新 ─────────── -->
            <TabItem x:Name="UpdateTab" Header="更新" />

            <!-- ─────────── 帮助 ─────────── -->
            <!-- 内容由 HelpContent.Render() 生成：二十多个参数 × 五行说明，写死在 XAML 里会难以维护 -->
            <TabItem Header="帮助">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 固定在顶部：不随内容滚动。
                         搜索框（TextBox）和按钮如果跟在滚动区里，每次滚动都要参与重绘，
                         是"帮助页滚起来发涩"的来源之一。 -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="24,18,24,0">
                        <StackPanel>
                            <TextBlock x:Name="HelpQuickTitle" Text="快速定位" Style="{StaticResource H2}" Margin="0,0,0,8" />
                            <TextBox x:Name="HelpSearchBox" Style="{StaticResource DarkTextBox}"
                                     TextChanged="HelpSearch_Changed"
                                     ToolTip="输入参数名或关键词，只留下包含它的说明" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="HelpJumpAccel" Content="加速" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                        Click="HelpJump_Click" Tag="加速" />
                                <Button x:Name="HelpJumpSmooth" Content="平滑滚动" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                        Click="HelpJump_Click" Tag="平滑滚动" />
                                <Button x:Name="HelpJumpApps" Content="应用名单" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                        Click="HelpJump_Click" Tag="应用名单" />
                                <Button x:Name="HelpJumpFaq" Content="常见问题" Style="{StaticResource GhostButton}"
                                        Click="HelpJump_Click" Tag="常见问题" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" x:Name="HelpScroll" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="HelpPanel" Margin="24,18,24,26" />
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ─────────── 关于 ─────────── -->
            <TabItem x:Name="AboutTab" Header="关于" />

        </TabControl>

            <!-- 底栏：数据目录 + 右侧统计。刻意做得很轻，不抢视线 -->
            <Border Grid.Row="2" Padding="24,7" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource BorderBrushSoft}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Click="OpenDataDir_Click"
                            ToolTip="点击打开数据目录">
                        <TextBlock x:Name="FooterDataDir" Style="{StaticResource Mono}" FontSize="10.5"
                                   TextTrimming="CharacterEllipsis" MaxWidth="560" />
                    </Button>
                    <TextBlock x:Name="FooterRight" Grid.Column="1" Style="{StaticResource Caption}" FontSize="10.5"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
