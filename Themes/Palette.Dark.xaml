<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ══════════════════════ 深色调色板 ══════════════════════

        这里**只有颜色**，控件样式在 Themes/Controls.xaml。

        拆开的理由：换主题只需要换这一份字典，样式一份就够。
        如果每个主题都存一份完整样式（600 行 ×2），以后改一个圆角要改两处，
        迟早会出现"浅色模式某个按钮还是深色"这种不一致。

        两边的 Key 必须**完全一致** —— 样式里全部用 DynamicResource 指向这些 Key，
        少一个就会在切换主题时变成透明/黑色。自检里有断言在守这条线。
    -->

    <!-- 背景三层：窗口 → 侧栏 → 卡片 → 卡片内嵌块 -->
    <SolidColorBrush x:Key="WindowBg" Color="#0F1117" />
    <SolidColorBrush x:Key="PanelBg" Color="#141821" />
    <SolidColorBrush x:Key="CardBg" Color="#1A1F2A" />
    <SolidColorBrush x:Key="CardBg2" Color="#212734" />

    <!-- 输入框单独一档：深色模式下它和侧栏同色没关系，浅色下必须是白的 -->
    <SolidColorBrush x:Key="FieldBg" Color="#141821" />

    <!-- 描边 -->
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#252C39" />
    <SolidColorBrush x:Key="BorderBrushStrong" Color="#39435A" />

    <!-- 文字三级 -->
    <SolidColorBrush x:Key="TextPrimary" Color="#E9ECF3" />
    <SolidColorBrush x:Key="TextSecondary" Color="#98A2B3" />
    <SolidColorBrush x:Key="TextMuted" Color="#6B7486" />

    <!-- 强调色 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#5B8CFF" />
    <SolidColorBrush x:Key="AccentHover" Color="#7BA3FF" />
    <SolidColorBrush x:Key="AccentSoft" Color="#2A3B63" />
    <SolidColorBrush x:Key="AccentFaint" Color="#1B2537" />

    <!-- 语义色 -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#34D399" />
    <SolidColorBrush x:Key="WarnBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />

    <!-- 轨道（滑块底槽、开关底槽） -->
    <SolidColorBrush x:Key="TrackBrush" Color="#2B3341" />

    <!-- 以下这些原本是散在样式里的写死颜色，收进调色板才能被浅色模式覆盖 -->
    <SolidColorBrush x:Key="SwitchKnob" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SelectedText" Color="#EAF0FF" />
    <SolidColorBrush x:Key="NavHoverBg" Color="#181D26" />
    <SolidColorBrush x:Key="ListHoverBg" Color="#27303F" />
    <SolidColorBrush x:Key="ScrollThumbBg" Color="#3A4353" />
    <SolidColorBrush x:Key="DangerHoverBg" Color="#3A2226" />
    <SolidColorBrush x:Key="SliderThumbStroke" Color="#0F1117" />
    <SolidColorBrush x:Key="PrimaryBtnFg" Color="#0E1420" />

    <!-- 倍率曲线用（Canvas 里现画的线，代码按 Key 取） -->
    <SolidColorBrush x:Key="CurveGrid" Color="#252C39" />
    <SolidColorBrush x:Key="CurveGuide" Color="#665B8CFF" />
    <SolidColorBrush x:Key="CurveArea" Color="#225B8CFF" />

</ResourceDictionary>
