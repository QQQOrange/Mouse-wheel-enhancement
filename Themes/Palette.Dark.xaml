<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ══════════════════════ 深色调色板 ══════════════════════

        这里**只有颜色**，控件样式在 Themes/Controls.xaml。

        拆分理由：换主题只换这一份字典，样式一份就够。
        若每套主题都存一份完整样式（600 行 ×2），以后改一个圆角要改两处，
        迟早出现"浅色模式某个按钮还是深色"这种不一致。

        两边的 Key 必须**完全一致** —— 样式里全部用 DynamicResource 指向这些 Key，
        少一个就会在切换主题时变成透明/黑色。自检里有断言在守这条线。
    -->

    <!-- 背景层级：窗口渐变 → 侧栏 → 卡片 → 卡片内嵌块 -->
    <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#11151C" Offset="0" />
        <GradientStop Color="#0E1118" Offset="0.55" />
        <GradientStop Color="#121826" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="WindowBg" Color="#0F1218" />
    <SolidColorBrush x:Key="PanelBg" Color="#141821" />
    <SolidColorBrush x:Key="CardBg" Color="#1A1E27" />
    <SolidColorBrush x:Key="CardBg2" Color="#20252F" />

    <!-- 输入框单独一档：深色下和侧栏同色没关系，浅色下必须是白的 -->
    <SolidColorBrush x:Key="FieldBg" Color="#141821" />

    <!-- 描边 -->
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#2A3040" />
    <SolidColorBrush x:Key="BorderBrushStrong" Color="#394154" />

    <!-- 文字三级 -->
    <SolidColorBrush x:Key="TextPrimary" Color="#EDF1F8" />
    <SolidColorBrush x:Key="TextSecondary" Color="#A6B0C3" />
    <SolidColorBrush x:Key="TextMuted" Color="#8C96A8" />

    <!-- 强调色 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#5B93FF" />
    <SolidColorBrush x:Key="AccentHover" Color="#79A7FF" />
    <SolidColorBrush x:Key="AccentSoft" Color="#1C2942" />
    <SolidColorBrush x:Key="AccentSoftBorder" Color="#2C4370" />
    <SolidColorBrush x:Key="AccentFaint" Color="#182338" />

    <!-- 语义色 -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#3DD68C" />
    <SolidColorBrush x:Key="WarnBrush" Color="#F5A524" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6369" />

    <!-- 轨道（滑块底槽、开关底槽） -->
    <SolidColorBrush x:Key="TrackBrush" Color="#2E3546" />

    <!-- 交互态：导航项、列表行的悬停与选中 -->
    <SolidColorBrush x:Key="HoverBg" Color="#232936" />
    <SolidColorBrush x:Key="SelectedBg" Color="#1E2C46" />

    <!-- 原本散在样式里的写死颜色，收进调色板才能被浅色模式覆盖 -->
    <SolidColorBrush x:Key="SwitchKnob" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SelectedText" Color="#EAF0FF" />
    <SolidColorBrush x:Key="NavHoverBg" Color="#232936" />
    <SolidColorBrush x:Key="ListHoverBg" Color="#232936" />
    <SolidColorBrush x:Key="ScrollThumbBg" Color="#3A4354" />
    <SolidColorBrush x:Key="DangerHoverBg" Color="#3A2226" />
    <SolidColorBrush x:Key="SliderThumbStroke" Color="#0F1218" />
    <SolidColorBrush x:Key="PrimaryBtnFg" Color="#FFFFFF" />

    <!-- 主按钮禁用态：不能再整块 Opacity 褪色（蓝底白字一起变淡，
         深色底下几乎看不见），改成专用的低饱和底 + 中等亮度字。 -->
    <SolidColorBrush x:Key="PrimaryBtnDisabledBg" Color="#2A3444" />
    <SolidColorBrush x:Key="PrimaryBtnDisabledFg" Color="#9AA6BC" />

    <!-- 倍率曲线用（Canvas 里现画的线，代码按 Key 取） -->
    <SolidColorBrush x:Key="CurveGrid" Color="#2A3040" />
    <SolidColorBrush x:Key="CurveGuide" Color="#665B93FF" />
    <SolidColorBrush x:Key="CurveArea" Color="#225B93FF" />

</ResourceDictionary>
