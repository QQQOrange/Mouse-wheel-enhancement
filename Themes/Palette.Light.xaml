<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ══════════════════════ 浅色调色板 ══════════════════════

        Key 与 Palette.Dark.xaml **一一对应**，顺序也一样，方便对照着改。
        少一个 Key，切换主题时对应控件就会失去颜色（透明或黑）——
        自检里有断言在守这条线（见 SelfTest.TestThemePalette）。

        取值原则：
          · 背景不是纯白。窗口用极淡的渐变、卡片纯白，靠明度差分层；
            全白会让卡片看不清边界，纯白底也更刺眼。
          · 文字不用纯黑。#171B26 在浅底上对比足够，又不至于像 #000 那样发死。
          · 强调色比深色模式**更深**（#2F6BF0 而不是 #5B93FF）：
            同一个颜色在浅底上会显浅，直接用深色模式那支会糊成一片。
    -->

    <!-- 背景层级 -->
    <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FCFDFF" Offset="0" />
        <GradientStop Color="#F4F6FB" Offset="0.55" />
        <GradientStop Color="#F7F9FE" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="WindowBg" Color="#F7F8FC" />
    <SolidColorBrush x:Key="PanelBg" Color="#F1F4FA" />
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBg2" Color="#F5F7FC" />

    <SolidColorBrush x:Key="FieldBg" Color="#FFFFFF" />

    <!-- 描边 -->
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#E4E8F1" />
    <SolidColorBrush x:Key="BorderBrushStrong" Color="#CBD3E2" />

    <!-- 文字三级 -->
    <SolidColorBrush x:Key="TextPrimary" Color="#171B26" />
    <SolidColorBrush x:Key="TextSecondary" Color="#58627A" />
    <SolidColorBrush x:Key="TextMuted" Color="#8A93A8" />

    <!-- 强调色 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2F6BF0" />
    <SolidColorBrush x:Key="AccentHover" Color="#1F55D0" />
    <SolidColorBrush x:Key="AccentSoft" Color="#E1EAFF" />
    <SolidColorBrush x:Key="AccentSoftBorder" Color="#BFD2FA" />
    <SolidColorBrush x:Key="AccentFaint" Color="#EFF4FF" />

    <!-- 语义色（浅底上要压暗，否则黄字在白色上几乎看不见） -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#0E8A5F" />
    <SolidColorBrush x:Key="WarnBrush" Color="#A25A00" />
    <SolidColorBrush x:Key="DangerBrush" Color="#D03030" />

    <!-- 轨道 -->
    <SolidColorBrush x:Key="TrackBrush" Color="#DCE2EE" />

    <!-- 交互态 -->
    <SolidColorBrush x:Key="HoverBg" Color="#EDF1F8" />
    <SolidColorBrush x:Key="SelectedBg" Color="#E6EEFF" />

    <!-- 与深色模式同名的细节色 -->
    <SolidColorBrush x:Key="SwitchKnob" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SelectedText" Color="#17356B" />
    <SolidColorBrush x:Key="NavHoverBg" Color="#EDF1F8" />
    <SolidColorBrush x:Key="ListHoverBg" Color="#EDF1F8" />
    <SolidColorBrush x:Key="ScrollThumbBg" Color="#C3CBD9" />
    <SolidColorBrush x:Key="DangerHoverBg" Color="#FBE7E7" />
    <SolidColorBrush x:Key="SliderThumbStroke" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PrimaryBtnFg" Color="#FFFFFF" />

    <!-- 倍率曲线 -->
    <SolidColorBrush x:Key="CurveGrid" Color="#DCE2EE" />
    <SolidColorBrush x:Key="CurveGuide" Color="#552F6BF0" />
    <SolidColorBrush x:Key="CurveArea" Color="#222F6BF0" />

</ResourceDictionary>
